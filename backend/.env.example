PORT=4000
NODE_ENV=development

# SQLite (dev) — for production use Postgres and set provider in schema.prisma
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/whosenearby?schema=public"

# REQUIRED in production: 32+ random characters
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# OTP
OTP_DEMO_CODE="123456"
OTP_TTL_MINUTES=5
# Never true in public production
OTP_EXPOSE_CODE=true
# console | twilio | termii | africastalking
OTP_PROVIDER=twilio

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a Twilio phone number you own, E.164 e.g. +15551234567
TWILIO_FROM_NUMBER=

TERMII_API_KEY=
TERMII_SENDER_ID=WhoseNear
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=WhoseNear

# Paystack (leave empty for demo wallet top-up)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# FCM legacy server key (optional — in-app Alerts work without it)
FCM_SERVER_KEY=

# Admin dashboard API (header: x-admin-key)
ADMIN_API_KEY="change-me-to-a-long-random-string"

UPLOAD_MAX_BYTES=5242880
JSON_BODY_LIMIT=6mb
CORS_ORIGIN=
